# Copy to .env and change these before deploying.
ADMIN_PASSWORD=change-me-admin
MEMBER_PASSWORD=change-me-rowers
# Long random string; keeps people signed in across restarts. Generate with:  openssl rand -base64 48
SECRET_KEY=
# Set to 1 when served over HTTPS (recommended), so the session cookie is Secure.
COOKIE_SECURE=0
TZ_NAME=Europe/London
# Public address of the site, e.g. https://outings.example.org. Used in calendar-subscription links;
# only needed if links come out wrong behind your reverse proxy.
PUBLIC_URL=

# Host folder that holds all app data (database, session key, backups). Unraid example:
# DATA_PATH=/mnt/user/appdata/outing-planner
DATA_PATH=./data
# User/group that owns the data files (Unraid: 99/100 = nobody/users).
PUID=99
PGID=100

# Egress firewall inside the container: internet only, no LAN / host / other containers / tailnet.
# Needs the NET_ADMIN capability (docker-compose.yml adds it). Set to off to disable.
EGRESS_FIREWALL=on
# Public DNS resolvers used by the container while the firewall is on.
EGRESS_DNS=1.1.1.1 9.9.9.9

# Encryption key for phone numbers (at least 16 characters). Generate with:  openssl rand -base64 32
# Keep it OUT of the data folder and back it up separately. Without it, the sign-up form doesn't ask
# for phone numbers; if it's lost, stored numbers become unreadable (people can simply re-enter them).
# To change it: put the new key in PHONE_KEY and the old one in PHONE_KEY_OLD for one restart.
PHONE_KEY=
PHONE_KEY_OLD=
