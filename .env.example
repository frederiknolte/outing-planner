# Copy to .env and change these before deploying.
ADMIN_PASSWORD=change-me-admin
MEMBER_PASSWORD=change-me-rowers
# Long random string; keeps people signed in across restarts. Generate with:  openssl rand -base64 48
SECRET_KEY=
# Set to 1 when served over HTTPS (recommended), so the session cookie is Secure.
COOKIE_SECURE=0
TZ_NAME=Europe/London
# Public address of the site, e.g. https://outings.example.org. Used in calendar-subscription links;
# only needed if links come out wrong behind your reverse proxy.
PUBLIC_URL=

# Host folder that holds all app data (database, session key, backups). Unraid example:
# DATA_PATH=/mnt/user/appdata/outing-planner
DATA_PATH=./data
# User/group that owns the data files (Unraid: 99/100 = nobody/users).
PUID=99
PGID=100
